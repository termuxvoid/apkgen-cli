 ⣀⡀ ⣉⣉⣉⣉⣉⣉⣉⣉⣉⣉⣉⣉⣉⣉⣉ ⢀⣀ 
⢸⣿⣿ ⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿ ⣿⣿⡇
⢸⣿⣿ ⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿ ⣿⣿⡇
⢸⣿⣿ ⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿ ⣿⣿⡇
⢸⣿⣿ ⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿ ⣿⣿⡇
⠘⠛⠛ ⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿ ⠛⠛⠃
    ⠉⠛⢻⣿⣿⣿⠛⠛⠛⣿⣿⣿⡟⠛⠋    
      ⢸⣿⣿⣿   ⣿⣿⣿⡇      
       ⠛⠛⠋   ⠙⠛⠛⠁      '

show_banner() {
    local cols pad
    cols=$(tput cols 2>/dev/null || echo 80)
    pad=$(( (cols - 23) / 2 ))
    [ "$pad" -lt 0 ] && pad=0

    gum style \
        --foreground 39 \
        --margin "1 0 0 $pad" \
        "$LOGO"
    gum style \
        --align center \
        --width "$cols" \
        --margin "0 0 1 0" \
        "$(gum style --foreground 39 --bold 'apkgen') $(gum style --foreground 241 "v${VERSION}")" \
        "$(gum style --italic --foreground 241 'Generate & Build Android APKs')"
}

# ------------------------------
# BUILD COMMANDS
# ------------------------------
ensure_gradlew() {
    if [ -f "gradlew" ] && [ ! -x "gradlew" ]; then
        chmod +x gradlew
    fi
}

build_apk() {
    local build_type="$1"
    echo
    step "Building APK (${build_type})..."
    ensure_gradlew

    if [ ! -f "gradlew" ]; then
        error "No gradlew found. Are you in an Android project directory?"
    fi

    echo
    if [ "$build_type" = "release" ]; then
        ./gradlew assembleRelease --no-daemon || error "Gradle build failed."
    else
        ./gradlew assembleDebug --no-daemon || error "Gradle build failed."
    fi

    local apk_path
    if [ "$build_type" = "release" ]; then
        apk_path=$(find app/build/outputs/apk/release -name "*.apk" 2>/dev/null | head -1)
    else
        apk_path=$(find app/build/outputs/apk/debug -name "*.apk" 2>/dev/null | head -1)
    fi

    echo
    if [ -n "$apk_path" ] && [ -s "$apk_path" ]; then
        success "Build complete!"
        echo -e "  ${BOLD}APK:${RESET} ${WHITE}$(pwd)/$apk_path${RESET}"
        if [ "$build_type" = "release" ]; then
            echo -e "  ${YELLOW}Warning: Release APK is unsigned. Use apksigner or jarsigner to sign it.${RESET}"
        fi
    else
        error "Build output not found"
    fi
    echo
}

build_flutter() {
    local build_type="${1:-debug}"
    echo

    if ! is_flutter_project; then
        error "No Flutter project found (pubspec.yaml + lib/main.dart). Are you in a Flutter project directory?"
    fi

    case "$build_type" in
        debug|release) ;;
        *) error "Usage: apkgen build [debug|release]" ;;
    esac

    configure_flutter
    if [ "$build_type" = "release" ]; then
        step "Building Flutter APK (release)..."
        flutter build apk --release || error "Flutter build failed."
    else
        step "Building Flutter APK (debug)..."
        flutter build apk --debug --split-per-abi || error "Flutter build failed."
    fi

    local apk_path
    apk_path=$(find build/app/outputs -name "*-${build_type}.apk" 2>/dev/null | head -1)

    echo
    if [ -n "$apk_path" ] && [ -s "$apk_path" ]; then
        success "Build complete!"
        echo -e "  ${BOLD}APK:${RESET} ${WHITE}$(pwd)/$apk_path${RESET}"
        if [ "$build_type" = "release" ]; then
            echo -e "  ${YELLOW}Warning: Release APK uses the debug signing key. Not for Play Store distribution.${RESET}"
        fi
    else
        error "Build output not found"
    fi
    echo
}

clean_project() {
    echo
    if is_flutter_project; then
        step "Detected Flutter project"
        configure_flutter
        flutter clean
        success "Flutter project cleaned"
    elif [ -f "gradlew" ]; then
        step "Detected Gradle project"
        ensure_gradlew
        ./gradlew clean --no-daemon
        success "Gradle project cleaned"
    else
        error "No supported project found. Run this from a project root directory."
    fi
    echo
}

# ------------------------------
# INTERACTIVE MENU
# ------------------------------
create_wizard() {
    local type flag="" dir args=()
    type=$(gum choose --header "Project type" "Java" "Kotlin" "Flutter" "Native C" "Native C++") || return
    case "$type" in
        Java)        ;;
        Kotlin)      flag="--kotlin" ;;
        Flutter)     flag="--flutter" ;;
        "Native C")  flag="--nativec" ;;
        "Native C++") flag="--nativecpp" ;;
    esac

    dir=$(gum input --header "Project directory" --placeholder "myapp" --prompt "> ") || return
    [ -n "$dir" ] || return

    [ -n "$flag" ] && args+=("$flag")
    "$SELF" create "$dir" "${args[@]}"
}

show_menu() {
    while :; do
        clear
        show_banner
        echo
        local choice
        choice=$(gum choose --header "What do you want to do?" \
            "Create a new project" \
            "Build debug APK" \
            "Build release APK" \
            "Clean project" \
            "Show help" \
            "Exit") || return 0

        case "$choice" in
            "Create a new project") create_wizard ;;
            "Build debug APK")      "$SELF" build debug ;;
            "Build release APK")    "$SELF" build release ;;
            "Clean project")        "$SELF" clean ;;
            "Show help")            "$SELF" help ;;
            "Exit")                 return 0 ;;
        esac

        echo
        read -r -p "Press Enter to return to the menu..." _ || return 0
    done
}

# ------------------------------
# HELP
# ------------------------------
show_help() {
    show_banner
    echo
    echo -e "${BOLD}USAGE${RESET}"
    echo -e "  ${WHITE}apkgen${RESET}                        Interactive menu"
    echo -e "  ${WHITE}apkgen${RESET} ${GREEN}<command>${RESET} ${YELLOW}[options]${RESET}"
    echo
    echo -e "${BOLD}COMMANDS${RESET}"
    echo -e "  ${GREEN}create${RESET} ${YELLOW}<dir>${RESET}                     Create a new Java project (default)"
    echo -e "  ${GREEN}create${RESET} ${YELLOW}<dir> --kotlin${RESET}            Create a new Kotlin project"
    echo -e "  ${GREEN}create${RESET} ${YELLOW}<dir> --flutter${RESET}           Create a new Flutter project"
    echo -e "  ${GREEN}create${RESET} ${YELLOW}<dir> --nativec${RESET}           Create a new Native C project"
    echo -e "  ${GREEN}create${RESET} ${YELLOW}<dir> --nativecpp${RESET}         Create a new Native C++ project"
    echo
    echo -e "  ${GREEN}build debug${RESET}               Build debug APK (auto-detects project)"
    echo -e "  ${GREEN}build release${RESET}             Build release APK (auto-detects project)"
    echo -e "  ${GREEN}build flutter${RESET}             Flutter alias: debug by default, or 'release'"
    echo
    echo -e "  ${GREEN}clean${RESET}                     Clean build artifacts"
    echo -e "  ${GREEN}version${RESET}                   Show version"
    echo -e "  ${GREEN}help${RESET}                      Show this help message"
    echo
    echo -e "  ${DIM}Flutter release APKs use the debug signing key (testing only).${RESET}"
    echo
    echo -e "${BOLD}EXAMPLES${RESET}"
    echo -e "  ${DIM}# Open the interactive menu${RESET}"
    echo -e "  ${WHITE}apkgen${RESET}"
    echo
    echo -e "  ${DIM}# Create and build a Java app${RESET}"
    echo -e "  ${WHITE}apkgen create myapp${RESET}"
    echo -e "  ${WHITE}cd myapp && apkgen build debug${RESET}"
    echo
    echo -e "  ${DIM}# Create a Kotlin app${RESET}"
    echo -e "  ${WHITE}apkgen create myapp --kotlin${RESET}"
    echo
    echo -e "  ${DIM}# Create a Flutter app${RESET}"
    echo -e "  ${WHITE}apkgen create myapp --flutter${RESET}"
    echo
}

# ------------------------------
# MAIN DISPATCHER
# ------------------------------
if [ $# -eq 0 ]; then
    if [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1; then
        show_menu
    else
        show_help
    fi
    exit 0
fi

case "$1" in
    create)
        shift
        template_type="java"
        app_dir=""

        for arg in "$@"; do
            case "$arg" in
                --kotlin)     template_type="kotlin" ;;
                --flutter)    template_type="flutter" ;;
                --nativec)    template_type="nativec" ;;
                --nativecpp)  template_type="nativecpp" ;;
                -*)           error "Unknown option: $arg" ;;
                *)            app_dir="$arg" ;;
            esac
        done

        if [ -z "$app_dir" ]; then
            error "Usage: apkgen create <dir> [--kotlin|--flutter|--nativec|--nativecpp]"
        fi

        if [ -d "$app_dir" ]; then
            error "Directory '$app_dir' already exists"
        fi

        case "$template_type" in
            java)      source "$SCRIPT_DIR/lib/create_java.sh"; create_java "$app_dir" ;;
            kotlin)    source "$SCRIPT_DIR/lib/create_kotlin.sh"; create_kotlin "$app_dir" ;;
            flutter)   source "$SCRIPT_DIR/lib/create_flutter.sh"; create_flutter "$app_dir" ;;
            nativec)   source "$SCRIPT_DIR/lib/create_nativec.sh"; create_nativec "$app_dir" ;;
            nativecpp) source "$SCRIPT_DIR/lib/create_nativecpp.sh"; create_nativecpp "$app_dir" ;;
        esac
        ;;
    build)
        case "$2" in
            flutter)
                build_flutter "${3:-debug}"
                ;;
            debug|release)
                if is_flutter_project; then
                    build_flutter "$2"
                else
                    build_apk "$2"
                fi
                ;;
            *)
                error "Usage: apkgen build [debug|release]"
                ;;
        esac
        ;;
    clean)
        clean_project
        ;;
    version|--version|-v)
        echo "apkgen $VERSION"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        error "Unknown command: $1. Run 'apkgen help' for usage."
        ;;
esac
